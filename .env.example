# Copie este archivo a .env.local y complete los valores de su proyecto de
# Supabase (Project Settings → API Keys). .env.local no se sube a GitHub.
#
# Solo va la clave PÚBLICA (sb_publishable_...). NUNCA la clave secreta
# (sb_secret_...) ni la service_role: la app lo rechaza al arrancar.
VITE_SUPABASE_URL=https://su-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplace_esta_clave
